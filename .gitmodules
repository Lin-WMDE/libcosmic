[submodule "iced"]
	path = iced
	# WMDE: our own fork, because the vendored iced now carries WMDE patches (the
	# wgpu software-adapter filter and the Vulkan-only backend set). Upstream
	# pop-os/iced stays reachable inside the submodule as the `upstream` remote,
	# so syncing is still a plain fetch + merge.
	# SSH, like every other WMDE fork's origin: the HTTPS form has no credential
	# helper on this machine, so a push died with "could not read Username" while
	# the parent repo pushed anyway and briefly published a gitlink to a commit
	# that existed nowhere but the local disk.
	url = git@github.com:Lin-WMDE/iced.git
	branch = wmde
[submodule "icon-theme"]
	path = cosmic-icons
	url = https://github.com/pop-os/cosmic-icons
